# The persist partition holds the factory reset protection data,
# label the node itself as the by-name links are labeled persist_block_device
/dev/block/mmcblk0p22                                u:object_r:frp_block_device:s0

/persist/wlan_mac\.bin                               u:object_r:wifi_data_file:s0
/persist/acc_avg(/.*)?                               u:object_r:sensors_persist_file:s0
/persist/prox_avg(/.*)?                              u:object_r:sensors_persist_file:s0

/data/vendor/a3-persist(/.*)?                        u:object_r:persist_file:s0
/data/vendor/a3-persist/wlan_mac\.bin                u:object_r:wifi_data_file:s0
/data/vendor/a3-persist/(acc_avg|prox_avg)(/.*)?       u:object_r:sensors_persist_file:s0

# NFC
/(vendor|system/vendor)/bin/hw/android\.hardware\.nfc@1\.0-service\.samsung u:object_r:hal_nfc_default_exec:s0

# This legacy ARM camera blob has text relocations. Keep the vendor label so
# the existing mm-qcamerad vendor_file execmod rule applies on non-Treble builds.
/system/vendor/lib/libmmcamera_faceproc\.so           u:object_r:vendor_file:s0
/vendor/lib/libmmcamera_faceproc\.so                  u:object_r:vendor_file:s0

/(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator-service\.a3lte    u:object_r:hal_vibrator_default_exec:s0

# CM36652 reads this factory cancellation value from its sysfs callbacks.
/efs/prox_cal                                      u:object_r:sensor_efs_file:s0
