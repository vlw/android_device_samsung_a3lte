cc_binary {
    name: "android.hardware.nfc@1.0-service.samsung",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.nfc@1.0-service.samsung.rc"],
    vintf_fragments: ["android.hardware.nfc@1.0-service.samsung.xml"],
    srcs: [
        "Nfc.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.nfc@1.0",
    ],
}

// Optional regression test; deliberately not in PRODUCT_PACKAGES.
cc_binary {
    name: "a3_nfc_lifecycle_test",
    vendor: true,
    srcs: ["Nfc.cpp", "tests/lifecycle_test.cpp"],
    shared_libs: ["libhardware", "libhidlbase", "liblog", "libutils", "android.hardware.nfc@1.0"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
