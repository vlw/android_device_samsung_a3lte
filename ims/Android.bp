// SPDX-License-Identifier: GPL-2.0
package {
    default_applicable_licenses: ["a3lte_ims_license"],
}
license {
    name: "a3lte_ims_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-GPL-2.0"],
    license_text: ["LICENSE"],
}
android_app {
    name: "A3Ims",
    srcs: ["src/**/*.kt", "src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    min_sdk_version: "32",
    jni_libs: ["liba3_evs_jni", "libevs_float"],
    use_embedded_native_libs: true,
    static_libs: ["kotlin-stdlib", "kotlinx_coroutines", "kotlinx_coroutines_android"],
    kotlincflags: ["-Xopt-in=kotlin.ExperimentalStdlibApi"],
    optimize: { enabled: false },
}

runtime_resource_overlay {
    name: "A3ImsFrameworkOverlay",
    manifest: "overlays/Framework/AndroidManifest.xml",
    resource_dirs: ["overlays/Framework/res"],
    certificate: "platform",
    product_specific: true,
}

runtime_resource_overlay {
    name: "A3ImsTelephonyOverlay",
    manifest: "overlays/Telephony/AndroidManifest.xml",
    resource_dirs: ["overlays/Telephony/res"],
    certificate: "platform",
    product_specific: true,
}

runtime_resource_overlay {
    name: "A3ImsCarrierOverlay",
    manifest: "overlays/Carrier/AndroidManifest.xml",
    resource_dirs: ["overlays/Carrier/res"],
    certificate: "platform",
    product_specific: true,
}

cc_binary {
    name: "a3_evs_probe",
    srcs: ["native/evs_probe.cpp"],
    shared_libs: ["libdl", "libm"],
    compile_multilib: "32",
    cflags: ["-Wall", "-Werror"],
}

cc_library_shared {
    name: "liba3_evs_jni",
    srcs: ["native/evs_jni.cpp"],
    shared_libs: ["libdl"],
    header_libs: ["jni_headers"],
    cppflags: ["-fexceptions"],
    compile_multilib: "32",
    cflags: ["-Wall", "-Werror"],
}

cc_library_shared {
    name: "liba3ims_radio",
    vendor: true,
    srcs: ["native/ims_radio.cpp", "native/ims_srvcc.cpp"],
    include_dirs: ["device/samsung/msm8916-common/ril/include"],
    shared_libs: ["libdl", "liblog", "libcrypto"],
    compile_multilib: "32",
    cflags: ["-Wall", "-Werror", "-DRIL_SHLIB"],
}

// Explicit parser diagnostic, not included in PRODUCT_PACKAGES.
cc_binary {
    name: "a3_srvcc_probe",
    srcs: ["native/srvcc_probe.cpp"],
    shared_libs: ["libdl"],
    compile_multilib: "32",
    cflags: ["-Wall", "-Werror"],
}
